  m_Script: {fileID: 11500000, guid: 4183aa6e65cb2cf469c372bb191ccd52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modelButtons:
  - button: {fileID: 99721899}
    prefab: {fileID: 2158177656987392133, guid: c9943946823e705409704c5320e98003,
      type: 3}
    headerText: "\u041F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044F
      \u0432 \u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u043E\u043C \u0442\u0435\u0430\u0442\u0440\u0435
      \u043A\u0443\u043A\u043E\u043B"
    descriptionText: "\u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u0438\u0439
      \u0442\u0435\u0430\u0442\u0440 \u043A\u0443\u043A\u043E\u043B \xAB\u0428\u0443\u0442\xBB
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C
      \xAB\u041A\u0430\u0440\u044C\u0435\u0440\u0430 \u0410\u0440\u0442\u0443\u0440\u043E
      \u0423\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u043E\u0433\u043B\u043E
      \u043D\u0435 \u0431\u044B\u0442\u044C\xBB \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C
      \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F \u0412\u0430\u043B\u0435\u0440\u0438\u044F
      \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E. \u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u043E\u043C-\u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0449\u0438\u043A\u043E\u043C
      \u0441\u0442\u0430\u043B\u0430 \u0415\u043B\u0435\u043D\u0430 \u041B\u0443\u0446\u0435\u043D\u043A\u043E.
      \u0420\u0430\u0431\u043E\u0442\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
      \u0441\u043E\u0431\u043E\u0439 \u0440\u0435\u0434\u043A\u0438\u0439 \u0434\u043B\u044F
      \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u043E\u0439 \u0441\u0446\u0435\u043D\u044B
      \u043F\u0440\u0438\u043C\u0435\u0440 \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0434\u0440\u0430\u043C\u044B,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043A\u0443\u043A\u043B\u044B
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u043A\u0430\u043A \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0434\u043B\u044F
      \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0441\u0430\u0442\u0438\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0437\u0430\u043C\u044B\u0441\u043B\u0430 \u0411\u0440\u0435\u0445\u0442\u0430.
      \u041F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0430
      \u043B\u0438\u043D\u0438\u044E \u0442\u0435\u0430\u0442\u0440\u0430 \xAB\u0428\u0443\u0442\xBB
      \u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 \u0436\u0430\u043D\u0440\u043E\u0432\u044B\u0445
      \u0440\u0430\u043C\u043E\u043A \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u043E\u0433\u043E
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430
      \u0435\u0433\u043E \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B \u043A\u0430\u043A
      \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0433\u043E \u0442\u0435\u0430\u0442\u0440\u0430."
    imageSprite: {fileID: 21300000, guid: 744b884f5ab1b4aefb7838eeec4d046a, type: 3}
    correctZoneTag: Trigger_First
    isPlacedCorrectly: 0
  - button: {fileID: 838937154}
    prefab: {fileID: 2158177656987392133, guid: c9943946823e705409704c5320e98003,
      type: 3}
    headerText: "\u0421\u043C\u044B\u0441\u043B \u0438 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0432\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u043E\u0439
      \u0432\u0435\u0440\u0441\u0438\u0438"
    descriptionText: "\u0412\u044B\u0431\u043E\u0440 \u043F\u044C\u0435\u0441\u044B
      \u0411\u0440\u0435\u0445\u0442\u0430 \u0434\u043B\u044F \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u043E\u0433\u043E
      \u0442\u0435\u0430\u0442\u0440\u0430 \u0431\u044B\u043B \u0441\u043C\u0435\u043B\u044B\u043C
      \u0448\u0430\u0433\u043E\u043C: \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
      1990-\u0445 \u0433\u043E\u0434\u043E\u0432, \u043D\u0430 \u0444\u043E\u043D\u0435
      \u043F\u0435\u0440\u0435\u043C\u0435\u043D \u0438 \u043F\u043E\u0438\u0441\u043A\u043E\u0432
      \u043D\u043E\u0432\u043E\u0433\u043E \u044F\u0437\u044B\u043A\u0430 \u0432
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435, \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E \u0432\u043B\u0430\u0441\u0442\u0438, \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u0438
      \u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u0434\u0438\u043A\u0442\u0430\u0442\u0443\u0440\u044B
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043E\u0431\u0440\u0430\u0437\u044B \u043A\u0443\u043A\u043E\u043B. \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u0438\u0439
      \u0441\u0442\u0440\u0435\u043C\u0438\u043B\u0441\u044F \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043A\u0443\u043A\u043B\u044B \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B
      \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u044B\u0435,
      \u043E\u0441\u0442\u0440\u044B\u0435 \u0442\u0435\u043C\u044B \u043D\u0435
      \u043C\u0435\u043D\u0435\u0435 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0447\u0435\u043C \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0430\u043A\u0442\u0451\u0440\u044B. \u041F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430
      \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0430\u0441\u044C \u044F\u0440\u043A\u043E\u0439
      \u0441\u0446\u0435\u043D\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439, \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u044D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C
      \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F,
      \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u043E \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u043E\u0439
      \u0447\u0435\u0440\u0442\u043E\u0439 \u0442\u0435\u0430\u0442\u0440\u0430 \u0442\u043E\u0433\u043E
      \u043F\u0435\u0440\u0438\u043E\u0434\u0430."
    imageSprite: {fileID: 21300000, guid: 744b884f5ab1b4aefb7838eeec4d046a, type: 3}
    correctZoneTag: Trigger_Second
    isPlacedCorrectly: 0
  - button: {fileID: 1656406489}
    prefab: {fileID: 2158177656987392133, guid: c9943946823e705409704c5320e98003,
      type: 3}
    headerText: "\u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044F
      \u0438 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043E \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0442\u0435\u0430\u0442\u0440\u0430"
    descriptionText: "\u0421\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C \xAB\u041A\u0430\u0440\u044C\u0435\u0440\u0430
      \u0410\u0440\u0442\u0443\u0440\u043E \u0423\u0438, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043C\u043E\u0433\u043B\u043E \u043D\u0435 \u0431\u044B\u0442\u044C\xBB \u0441\u0442\u0430\u043B
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
      \u0440\u0430\u0431\u043E\u0442 \u044D\u043F\u043E\u0445\u0438 \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E
      \u0438 \u0432\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
      \u043D\u0435\u043E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u043E \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0441\u044F
      \u043A\u0430\u043A \u043F\u0440\u0438\u043C\u0435\u0440 \xAB\u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0433\u043E\xBB
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0442\u0435\u0430\u0442\u0440\u0430
      \xAB\u0428\u0443\u0442\xBB. \u041E\u043D \u0443\u043A\u0440\u0435\u043F\u0438\u043B
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E \u0442\u0435\u0430\u0442\u0440\u0430
      \u043A\u0430\u043A \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0438 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0441\u043C\u0435\u043B\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438.
      \u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044F
      \u2014 \u043A\u0443\u043A\u043B\u044B, \u044D\u0441\u043A\u0438\u0437\u044B,
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F
      \u2014 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
      \u0432 \u043C\u0443\u0437\u0435\u0439\u043D\u044B\u0445 \u0438 \u0430\u0440\u0445\u0438\u0432\u043D\u044B\u0445
      \u0444\u043E\u043D\u0434\u0430\u0445 \u0442\u0435\u0430\u0442\u0440\u0430,
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C \u0447\u0430\u0441\u0442\u044C\u044E
      \u0435\u0433\u043E \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044F. \u041F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430
      \u0441\u0442\u0430\u043B\u0430 \u0432\u0430\u0436\u043D\u044B\u043C \u044D\u0442\u0430\u043F\u043E\u043C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u044B\u0439 \u0442\u0435\u0430\u0442\u0440
      \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0435 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
      \u0442\u0435\u043C\u044B \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043A \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u0434\u0440\u0430\u043C\u0430\u0442\u0443\u0440\u0433\u0438\u0438."
    imageSprite: {fileID: 21300000, guid: 744b884f5ab1b4aefb7838eeec4d046a, type: 3}
    correctZoneTag: Trigger_Third
    isPlacedCorrectly: 0
