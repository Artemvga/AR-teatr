  m_text: "\u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u0438\u0439 \u0442\u0435\u0430\u0442\u0440
    \u043A\u0443\u043A\u043E\u043B \u0438\u043C\u0435\u043D\u0438 \u0412.\u0410.
    \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0441\u044F
    \u0432 \u044D\u043F\u043E\u0445\u0443 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F \u0412\u0430\u043B\u0435\u0440\u0438\u044F
    \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E.\n\n\u041A\u0443\u043A\u043E\u043B\u044C\u043D\u044B\u0439
    \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C \xAB\u041C\u0435\u0440\u0442\u0432\u044B\u0435
    \u0434\u0443\u0448\u0438\xBB \u043F\u043E \u0413\u043E\u0433\u043E\u043B\u044E,
    \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D\u043D\u044B\u0439 \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u043F\u0440\u0435\u043C\u0438\u0438 \u0420\u043E\u0441\u0441\u0438\u0438, \u0441\u0442\u0430\u043B
    \u0432\u0438\u0437\u0438\u0442\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u043E\u0439
    \u0442\u0435\u0430\u0442\u0440\u0430, \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u044F
    \u0436\u0430\u043D\u0440 \u0444\u0430\u043D\u0442\u0430\u0441\u043C\u0430\u0433\u043E\u0440\u0438\u0438.
    \u0420\u0435\u043F\u0435\u0440\u0442\u0443\u0430\u0440 \u0432\u043A\u043B\u044E\u0447\u0430\u043B
    \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0435
    \u0434\u0440\u0430\u043C\u044B: \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043F\u0430\u043C\u0444\u043B\u0435\u0442 \xAB\u041A\u0430\u0440\u044C\u0435\u0440\u0430
    \u0410\u0440\u0442\u0443\u0440\u043E \u0423\u0438\xBB, \u0441\u0430\u0442\u0438\u0440\u0443
    \xAB\u0418\u0437 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445\xBB
    \u0438 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \xAB\u041E\u0437\u0435\u0440\u043D\u044B\u0439 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\xBB.
    \u041D\u0430\u0441\u043B\u0435\u0434\u0438\u0435 \u044D\u0442\u0438\u0445 \u0438
    \u0434\u0440\u0443\u0433\u0438\u0445 \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043E\u043A
    (\xAB\u041A\u0440\u0430\u0441\u0430 \u043D\u0435\u043D\u0430\u0433\u043B\u044F\u0434\u043D\u0430\u044F\xBB,
    \xAB\u041F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0430 \u0438 \u044D\u0445\u043E\xBB)
    \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F \u0432 \u041C\u0443\u0437\u0435\u0435
    \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u0443\u043A\u043B\u044B
    \u0438\u043C\u0435\u043D\u0438 \u0410.\u0410. \u0412\u0435\u0441\u0435\u043B\u043E\u0432\u0430."
