    \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E.\n\n\u041F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u0412\u0430\u043B\u0435\u0440\u0438\u0435\u043C \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u0438\u043C,
    \u043E\u043D \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u043D\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043A\u0443\u043A\u043E\u043B\u044C\u043D\u044B\u043C \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0435\u043C
    \u0434\u043B\u044F \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0439 \u0438 \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u0432\u043E\u0439
    \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438, \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F
    \u0442\u0435\u043C\u044B \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0445\u0440\u0443\u043F\u043A\u043E\u0441\u0442\u0438 \u0434\u0435\u0442\u0441\u043A\u043E\u0439
    \u0434\u0443\u0448\u0438. \u0421\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\u044B\u0441\u043E\u043A\u043E\u0435
    \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435 \u043A\u0440\u0438\u0442\u0438\u043A\u043E\u0432
    \u0437\u0430 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0443\u044E
    \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C. \u041A\u0443\u043A\u043B\u044B
    \u0438\u0437 \u044D\u0442\u043E\u0439 \u0437\u043D\u0430\u0447\u0438\u043C\u043E\u0439
    \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u0440\u0438\u043C\u044B\u043A\u0430\u0435\u0442 \u043A \xAB\u0437\u043E\u043B\u043E\u0442\u043E\u043C\u0443
    \u0444\u043E\u043D\u0434\u0443\xBB \u0442\u0435\u0430\u0442\u0440\u0430, \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F
    \u0432 \u041C\u0443\u0437\u0435\u0435 \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043A\u0443\u043A\u043B\u044B \u0438\u043C\u0435\u043D\u0438 \u0410.\u0410.
    \u0412\u0435\u0441\u0435\u043B\u043E\u0432\u0430."
