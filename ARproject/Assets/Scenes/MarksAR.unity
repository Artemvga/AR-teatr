--- !u!114 &18238861
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 18238859}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0410\u0432\u0442\u043E\u0440: \u0415\u0432\u0433\u0435\u043D\u0438\u0439
    \u0421\u043F\u0435\u0440\u0430\u043D\u0441\u043A\u0438\u0439 (\u043F\u044C\u0435\u0441\u0430
    \u043F\u043E \u043C\u043E\u0442\u0438\u0432\u0430\u043C \u0440\u0443\u0441\u0441\u043A\u0438\u0445
    \u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445 \u0441\u043A\u0430\u0437\u043E\u043A).\n\n\u0420\u0435\u0436\u0438\u0441\u0441\u0435\u0440:
    \u0412\u0430\u043B\u0435\u0440\u0438\u0439 \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u0438\u0439
    (\u043F\u0440\u0435\u043C\u044C\u0435\u0440\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C
    \u0432 1994 \u0433\u043E\u0434\u0443).\n\n\u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A:
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440 \u0415\u0447\u0435\u0438\u043D.\n\n\u041E
    \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u0435: \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u043C\u0440\u0430\u0447\u043D\u044B\u0445 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u043A\u0438\u0445
    \u043F\u043E\u043B\u043E\u0442\u0435\u043D, \u044D\u0442\u043E \u0431\u044B\u043B\u0430
    \u0441\u0432\u0435\u0442\u043B\u0430\u044F, \u043F\u043E\u044D\u0442\u0438\u0447\u043D\u0430\u044F
    \u0441\u043A\u0430\u0437\u043A\u0430, \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043D\u0430 \u0434\u0435\u0442\u0441\u043A\u0443\u044E \u0438 \u0441\u0435\u043C\u0435\u0439\u043D\u0443\u044E
    \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044E.\n\n\u0421\u044E\u0436\u0435\u0442:
    \u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043E \u0446\u0430\u0440\u0435\u0432\u0438\u0447\u0435, \u041A\u043E\u0449\u0435\u0435
    \u0411\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u043D\u043E\u043C \u0438 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
    \u041A\u0440\u0430\u0441\u044B \u043D\u0435\u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E\u0439.
    \u041E\u0434\u043D\u0430\u043A\u043E \u0432 \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435
    \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u043E\u043D\u0430
    \u043E\u0431\u0440\u0435\u043B\u0430 \u043E\u0441\u043E\u0431\u0443\u044E \u044D\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0433\u043B\u0443\u0431\u0438\u043D\u0443.\n\n\u0421\u0442\u0438\u043B\u044C:
    \u0421\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C \u0431\u044B\u043B \u0440\u0435\u0448\u0435\u043D
    \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044F\u0445 \u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
    \u0444\u043E\u043B\u044C\u043A\u043B\u043E\u0440\u0430, \u043D\u043E \u0441 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0439
    \u0441\u0446\u0435\u043D\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439. \u041A\u0443\u043A\u043B\u044B
    \u0410\u043B\u0435\u043A\u0441\u0430\u043D\u0434\u0440\u0430 \u0415\u0447\u0435\u0438\u043D\u0430
    \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0438\u0441\u044C \u0432\u044B\u0441\u043E\u043A\u043E\u0439
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E,
    \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044F \u043E\u0436\u0438\u0432\u0448\u0438\u0435
    \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043A \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u043C
    \u043A\u043D\u0438\u0433\u0430\u043C. \u0417\u0434\u0435\u0441\u044C \u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u0438\u0439
    \u0442\u0435\u0430\u0442\u0440 \u043A\u0443\u043A\u043E\u043B \u0438\u043C\u0435\u043D\u0438
    \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u043B
    \u0441\u0432\u043E\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
    \u0432 \u0440\u0430\u0431\u043E\u0442\u0435 \u0441 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0442\u0440\u043E\u0441\u0442\u0435\u0432\u043E\u0439 \u043A\u0443\u043A\u043B\u043E\u0439."
  m_isRightToLeft: 0
