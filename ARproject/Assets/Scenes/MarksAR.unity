--- !u!114 &1766583771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1766583769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u0434\u0430\u043D\u0438\u0435-\u0421\u043A\u0430\u0437\u043A\u0430:
    \u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0438 \u0421\u0435\u043A\u0440\u0435\u0442\u044B
    \u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u043E\u0433\u043E \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0422\u0435\u0430\u0442\u0440\u0430 \u041A\u0443\u043A\u043E\u043B\n\u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u0438\u0439
    \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0422\u0435\u0430\u0442\u0440 \u041A\u0443\u043A\u043E\u043B (\u043D\u043E\u0441\u044F\u0449\u0438\u0439
    \u0442\u0430\u043A\u0436\u0435 \u0438\u043C\u044F \u0412.\u0410. \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E)
    \u0432\u0435\u0434\u0435\u0442 \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E
    \u0441 1925 \u0433\u043E\u0434\u0430, \u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432
    1984 \u0433\u043E\u0434\u0443. \u0414\u043E \u044D\u0442\u043E\u0433\u043E \u0442\u0440\u0443\u043F\u043F\u0430
    \u0434\u043E\u043B\u0433\u0438\u0435 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u044E\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0445
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430\u0445, \u0432 \u0442\u043E\u043C
    \u0447\u0438\u0441\u043B\u0435 \u0432 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0445
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445 \u043A\u0438\u043D\u043E\u0442\u0435\u0430\u0442\u0440\u0430
    \xAB\u042E\u043D\u043E\u0441\u0442\u044C\xBB.\n\n\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u0435
    \u0427\u0443\u0434\u043E \u0438 \u041D\u0430\u0440\u043E\u0434\u043D\u0430\u044F
    \u0421\u0442\u0440\u043E\u0439\u043A\u0430\n\u0421\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u0439
    \u0417\u0430\u043C\u043E\u043A: \u0417\u0434\u0430\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
    \u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043E
    \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
    \u0441\u0440\u0435\u0434\u043D\u0435\u0432\u0435\u043A\u043E\u0432\u044B\u0439
    \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u0439 \u0437\u0430\u043C\u043E\u043A
    \u0441 \u043E\u0441\u0442\u0440\u043E\u0432\u0435\u0440\u0445\u0438\u043C\u0438
    \u043A\u0440\u044B\u0448\u0430\u043C\u0438, \u0431\u0430\u0448\u0435\u043D\u043A\u0430\u043C\u0438,
    \u043F\u043E\u0440\u0442\u0438\u043A\u0430\u043C\u0438 \u0438 \u043A\u043E\u043B\u043E\u043D\u043D\u0430\u043C\u0438.
    \u041E\u043D\u043E \u043A\u0430\u0440\u0434\u0438\u043D\u0430\u043B\u044C\u043D\u043E
    \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u043E\u0441\u044C \u043E\u0442 \u0442\u0438\u043F\u043E\u0432\u043E\u0439
    \u0441\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0439 \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438.\n\n\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u044B
    \u0438 \u041D\u0430\u0433\u0440\u0430\u0434\u044B: \u0417\u0430 \u044D\u0442\u043E\u0442
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442
    \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432 \u0430\u0432\u0442\u043E\u0440\u043E\u0432
    \u2014 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u044B \u041D.\u0421.
    \u0422\u043E\u043F\u043E\u0435\u0432 \u0438 \u0410. \u0424\u0440\u043E\u043B\u043E\u0432,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u044B
    \u0418.\u041D. \u0414\u0438\u043A\u0443\u043D\u043E\u0432 \u0438 \u042D.\u041D.
    \u041F\u0430\u043A \u2014 \u0431\u044B\u043B \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D
    \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u043F\u0440\u0435\u043C\u0438\u0438 \u0420\u0421\u0424\u0421\u0420.\n\n\u0421\u0435\u043A\u0440\u0435\u0442
    \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F: \u0417\u0434\u0430\u043D\u0438\u0435
    \u0442\u0435\u0430\u0442\u0440\u0430 \u0431\u044B\u043B\u043E \u0432\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043E
    \u043D\u0435 \xAB\u0441 \u043D\u0443\u043B\u044F\xBB, \u0430 \u043F\u0443\u0442\u0435\u043C
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u043E\u0439
    \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
    \u0434\u0432\u0443\u0445 \u0441\u0442\u0430\u0440\u044B\u0445 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0439,
    \u0441\u0442\u043E\u044F\u0432\u0448\u0438\u0445 \u043D\u0430 \u044D\u0442\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435: \u0436\u0438\u043B\u043E\u0433\u043E \u0434\u043E\u043C\u0430
    \u0438 \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0414\u043E\u043C\u0430 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B
    \u043F\u0440\u043E\u0444\u0441\u043E\u044E\u0437\u043E\u0432. \u0421\u0430\u043C\u043E
    \u0414\u043E\u043C \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B \u043F\u0440\u043E\u0444\u0441\u043E\u044E\u0437\u043E\u0432
    \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0441\u044F \u043D\u0430
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0435, \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0432\u0448\u0435\u043C
    \u0435\u0449\u0435 \u0412\u0442\u043E\u0440\u043E\u0439 \u043C\u0443\u0436\u0441\u043A\u043E\u0439
    \u0433\u0438\u043C\u043D\u0430\u0437\u0438\u0438 \u043D\u0430\u0447\u0430\u043B\u0430
    XIX \u0432\u0435\u043A\u0430.\n\n\u041C\u0435\u0442\u043E\u0434 \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430:
    \u0412\u043E\u043F\u0440\u0435\u043A\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0432\u0448\u0438\u043C
    \u0442\u043E\u0433\u0434\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F\u043C
    \u043D\u0430 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0441\u043E\u0446\u043A\u0443\u043B\u044C\u0442\u0431\u044B\u0442\u0430,
    \u0442\u0435\u0430\u0442\u0440 \u0432\u043E\u0437\u0432\u043E\u0434\u0438\u043B\u0441\u044F
    \u0443\u0434\u0430\u0440\u043D\u044B\u043C\u0438 \u0442\u0435\u043C\u043F\u0430\u043C\u0438
    \u043C\u0435\u0442\u043E\u0434\u043E\u043C \u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0439
    \u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0437\u043C\u0443 \u0433\u043E\u0440\u043E\u0436\u0430\u043D
    \u0438 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0435
    \u043D\u0435\u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u044B\u0445
    \u0436\u0438\u0442\u0435\u043B\u0435\u0439 \u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0430.\n\n\u041A\u0443\u043A\u043E\u043B\u044C\u043D\u044B\u0435
    \u0427\u0430\u0441\u044B \u0438 \u0421\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u043D\u044B\u0439
    \u0410\u043D\u0441\u0430\u043C\u0431\u043B\u044C\n\u0424\u0430\u0441\u0430\u0434
    \u0442\u0435\u0430\u0442\u0440\u0430 \u0438 \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0430\u044F
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430:\n\n\u0412\u0435\u043B\u0438\u043A\u0438\u0435
    \u041A\u0443\u043A\u043E\u043B\u044C\u043D\u044B\u0435 \u0427\u0430\u0441\u044B:
    \u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u044B
    \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0447\u0430\u0441\u044B, \u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043E\u0434\u043D\u0438\u043C
    \u0438\u0437 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432 \u0433\u043E\u0440\u043E\u0434\u0430.\n\n\u0420\u0430\u0437\u043C\u0435\u0440\u044B:
    \u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442\u0430
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 4,5 \u043C\u0435\u0442\u0440\u0430.
    \u0414\u043B\u0438\u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u043D\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043F\u043E\u0447\u0442\u0438 3 \u043C\u0435\u0442\u0440\u0430.\n\n\u041C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0421\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C: \u041A\u0430\u0436\u0434\u044B\u0439
    \u0447\u0430\u0441 \u043D\u0430 \u0447\u0430\u0441\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0444\u0438\u0433\u0443\u0440\u043A\u0438 \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u0445
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u0441\u0432\u043E\u0439
    \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \xAB\u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C\xBB.\n\n\u0418\u0441\u0442\u043E\u0440\u0438\u044F
    \u0421\u043D\u0430: \u0417\u0430 \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E
    \u0447\u0430\u0441\u044B \u043D\u0435 \u0440\u0430\u0437 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0434\u043E\u043B\u0433\u0438\u0435 \u0441\u0440\u043E\u043A\u0438.
    \u0412 \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u0435\u0440\u0438\u043E\u0434\u043E\u0432
    \xAB\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F\xBB \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B\u0438
    18 \u043B\u0435\u0442, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
    \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F,
    \u0447\u0442\u043E \u043F\u043E\u0440\u043E\u0434\u0438\u043B\u043E \u0441\u0440\u0435\u0434\u0438
    \u0433\u043E\u0440\u043E\u0436\u0430\u043D \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
    \u043B\u0435\u0433\u0435\u043D\u0434.\n\n\u041A\u0443\u043A\u0443\u0448\u043A\u0430:
    \u0423 \u0447\u0430\u0441\u043E\u0432 \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u044F
    \u043A\u0443\u043A\u0443\u0448\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F,
    \u0432\u043F\u0440\u043E\u0447\u0435\u043C, \u0437\u0430\u043C\u0438\u0440\u0430\u043B\u0430
    \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u0440\u0435\u043C\u043E\u043D\u0442\u0430.\n\n\u0421\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u043D\u043E\u0435
    \u041E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435: \u0424\u0430\u0441\u0430\u0434
    \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0434\u0432\u043E\u0440
    \u0443\u043A\u0440\u0430\u0448\u0435\u043D \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u043C\u0438
    \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438 \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u0445
    \u0433\u0435\u0440\u043E\u0435\u0432 \u0438 \u0434\u0435\u0442\u0430\u043B\u044F\u043C\u0438,
    \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u043C\u0438 \u0442\u0435\u043C\u0438
    \u0436\u0435 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u0430\u043C\u0438
    \u2014 \u0418. \u0414\u0438\u043A\u0443\u043D\u043E\u0432\u044B\u043C \u0438
    \u042D. \u041F\u0430\u043A\u043E\u043C.\n\n\u041F\u0430\u043C\u044F\u0442\u043D\u0438\u043A-\u0421\u0438\u043C\u0432\u043E\u043B:
    \u041F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u0432\u0445\u043E\u0434\u043E\u043C
    \u0432 \u0412\u043E\u0440\u043E\u043D\u0435\u0436\u0441\u043A\u0438\u0439 \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0422\u0435\u0430\u0442\u0440 \u041A\u0443\u043A\u043E\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D
    \u0432\u0441\u0435\u043D\u0430\u0440\u043E\u0434\u043D\u043E \u043B\u044E\u0431\u0438\u043C\u044B\u0439
    \u041F\u0430\u043C\u044F\u0442\u043D\u0438\u043A \u0411\u0435\u043B\u043E\u043C\u0443
    \u0411\u0438\u043C\u0443, \u0433\u0435\u0440\u043E\u044E \u043F\u043E\u0432\u0435\u0441\u0442\u0438
    \u0413\u0430\u0432\u0440\u0438\u0438\u043B\u0430 \u0422\u0440\u043E\u0435\u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0433\u043E.
    \u042D\u0442\u043E \u0442\u043E\u0436\u0435 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u043E\u0432 \u0414\u0438\u043A\u0443\u043D\u043E\u0432\u0430
    \u0438 \u041F\u0430\u043A\u0430, \u0438 \u043E\u043D \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u043D\u043E
    \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u0439
    \u0430\u043D\u0441\u0430\u043C\u0431\u043B\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u0438."
