--- !u!114 &125884305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 125884303}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0410\u0432\u0442\u043E\u0440: \u0412\u043B\u0430\u0441\u0442\u0430 \u041F\u043E\u0441\u043F\u0438\u0448\u0438\u043B\u043E\u0432\u0430
    (\u0427\u0435\u0445\u0438\u044F).\n\n\u0420\u0435\u0436\u0438\u0441\u0441\u0435\u0440:
    \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440 \u0413\u0443\u0441\u0430\u0440\u043E\u0432.\n\n\u0416\u0430\u043D\u0440:
    \u041B\u0438\u0440\u0438\u043A\u043E-\u0438\u0440\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0441\u043A\u0430\u0437\u043A\u0430.\n\n\u0421\u044E\u0436\u0435\u0442: \u0418\u0441\u0442\u043E\u0440\u0438\u044F
    \u043E \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u043E\u0439 \u043F\u0440\u0438\u043D\u0446\u0435\u0441\u0441\u0435,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0442\u0435\u0440\u044F\u0435\u0442
    \u0441\u0432\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 (\u0438\u043B\u0438 \u0435\u0433\u043E
    \u043A\u0440\u0430\u0441\u043E\u0442\u0443) \u0438 \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u0430
    \u0438\u0441\u043A\u0430\u0442\u044C \u042D\u0445\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435.
    \u0412 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435 \u043F\u043E\u0438\u0441\u043A\u043E\u0432
    \u0433\u0435\u0440\u043E\u0438\u043D\u044F \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F,
    \u0443\u0447\u0438\u0442\u0441\u044F \u0441\u043B\u044B\u0448\u0430\u0442\u044C
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0438 \u043B\u044E\u0431\u0438\u0442\u044C.\n\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438:
    \u042D\u0442\u043E \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0439,
    \u043B\u0435\u0433\u043A\u0438\u0439 \u0438 \u043E\u0447\u0435\u043D\u044C \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439
    \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C. \u0412 \u043D\u0435\u043C
    \u043C\u043D\u043E\u0433\u043E \u044E\u043C\u043E\u0440\u0430 \u0438 \u0432\u043E\u043B\u0448\u0435\u0431\u0441\u0442\u0432\u0430.
    \u0420\u0435\u0436\u0438\u0441\u0441\u0435\u0440 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440
    \u0413\u0443\u0441\u0430\u0440\u043E\u0432 (\u0443\u0447\u0435\u043D\u0438\u043A
    \u0412\u043E\u043B\u044C\u0445\u043E\u0432\u0441\u043A\u043E\u0433\u043E) \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
    \u043B\u0443\u0447\u0448\u0438\u0435 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438
    \u0442\u0435\u0430\u0442\u0440\u0430: \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043A \u0434\u0435\u0442\u0430\u043B\u0438, \u0434\u043E\u0431\u0440\u044B\u0439
    \u044E\u043C\u043E\u0440 \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441 \u043A\u0443\u043A\u043B\u043E\u0439.
    \u0421\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C \u0434\u043E\u043B\u0433\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u0443\u043A\u0440\u0430\u0448\u0430\u043B \u0434\u0435\u0442\u0441\u043A\u0438\u0439
    \u0440\u0435\u043F\u0435\u0440\u0442\u0443\u0430\u0440."
